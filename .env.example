# Deal Desk configuration. Copy to .env (or run `make init`, which does it for you).
# This file contains NO credentials. Every blank secret below is generated by `make init`
# into your git-ignored .env and printed once.

# ---------------------------------------------------------------- runtime
# local | test | staging | production. Anything other than local requires COOKIE_SECURE=true.
APP_ENV=local
LOG_LEVEL=INFO

# ---------------------------------------------------------------- database
POSTGRES_USER=dealdesk
POSTGRES_DB=dealdesk
# Generated by `make init`.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- authentication
# local (passwords + our own JWTs) | oidc (tokens from an external identity provider)
AUTH_MODE=local
JWT_ISSUER=dealdesk-local
JWT_AUDIENCE=dealdesk-api
# Folder holding the Ed25519 signing keys created by `make init` (git-ignored).
JWT_KEYS_DIR=/run/dealdesk-keys
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
# Must be true everywhere except APP_ENV=local over plain HTTP. The API refuses to start otherwise.
COOKIE_SECURE=false
# Comma-separated origins allowed to make state-changing requests (CSRF Origin check).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Argon2id parameters (OWASP-recommended minimums or above).
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=1
LOGIN_RATE_LIMIT_PER_IP_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_ACCOUNT_PER_MINUTE=10
LOCKOUT_THRESHOLD=5
LOCKOUT_SECONDS=900
API_RATE_LIMIT_PER_MINUTE=300

# OIDC mode only (AUTH_MODE=oidc). Example values for the optional dev Keycloak profile.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_CLIENT_ID=
OIDC_AUTHORIZE_URL=
OIDC_TOKEN_URL=
OIDC_ROLE_CLAIM=dealdesk_role
OIDC_CLOCK_SKEW_SECONDS=30

# Demo users, one per role. Passwords are generated by `make init`; the seed refuses to run
# unless APP_ENV=local. Emails use the reserved .example domain (RFC 2606).
DEMO_ADMIN_EMAIL=admin@dealdesk.example
DEMO_ADMIN_PASSWORD=
DEMO_ESTIMATOR_EMAIL=estimator@dealdesk.example
DEMO_ESTIMATOR_PASSWORD=
DEMO_APPROVER_EMAIL=approver@dealdesk.example
DEMO_APPROVER_PASSWORD=
DEMO_VIEWER_EMAIL=viewer@dealdesk.example
DEMO_VIEWER_PASSWORD=

# ---------------------------------------------------------------- model providers
# fake (default, offline, deterministic) | vertex | anthropic | openai
# With "fake", no brief text ever leaves this machine.
LLM_PROVIDER=fake
LLM_MODEL=fake-deterministic-v1
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096
# Used only to estimate model spend in the audit log (GBP per million tokens). Assumptions.
LLM_INPUT_GBP_PER_MTOK=0
LLM_OUTPUT_GBP_PER_MTOK=0
# fake (default) | vertex | openai
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-hashing-v1
EMBEDDING_DIM=256
# Vertex AI (only if LLM_PROVIDER/EMBEDDING_PROVIDER=vertex). Uses Application Default Credentials.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west2
# Only if LLM_PROVIDER=anthropic / openai.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------- commercial policy (assumptions)
CONTINGENCY=0.10
TARGET_MARGIN=0.35
MINIMUM_MARGIN=0.25
MAX_HOURS_PER_ROLE=2000
MAX_REVISIONS=2
VAT_RATE=0.20
# Invoice milestones: percentages (must sum to 100) and due-date offsets in days from start.
INVOICE_MILESTONE_PERCENTAGES=30,40,30
INVOICE_MILESTONE_OFFSET_DAYS=0,42,84
PROJECT_WEEKS=12
START_DATE_LEAD_DAYS=14
RETRIEVAL_TOP_K=3

# ---------------------------------------------------------------- uploads and runtime
UPLOAD_MAX_BYTES=10485760
WORKFLOW_MAX_WORKERS=4

# ---------------------------------------------------------------- front end
# Internal address the Next.js server uses to reach the API. Never exposed to the browser.
API_INTERNAL_URL=http://api:8000
