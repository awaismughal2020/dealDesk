# Deal Desk. Every target runs in Docker; the host needs only Docker and Make.
SHELL := /bin/bash
.DEFAULT_GOAL := help

export HOST_UID := $(shell id -u)
export HOST_GID := $(shell id -g)
export COMPOSE_BAKE := false

COMPOSE   := docker compose
DEV_IMAGE := dealdesk-dev:local
DEV       := $(COMPOSE) --profile tools run --rm --no-deps dev
DEV_DB    := $(COMPOSE) --profile tools run --rm dev
WEB_DEV   := $(COMPOSE) --profile tools run --rm --no-deps web-dev
TF_IMAGE  := hashicorp/terraform:1.17.2
HELM_IMAGE := alpine/helm:3.22.1
GITLEAKS_IMAGE := zricethezav/gitleaks:v8.30.1

.PHONY: help init rotate-keys up down logs seed demo gen-client test lint typecheck imports \
        web-lint web-test web-typecheck e2e check eval eval-record eval-live tf-validate helm-lint \
        audit secrets-scan clean dev-image

help: ## List targets
	@grep -E '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-14s\033[0m %s\n", $$1, $$2}'

dev-image:
	@docker build -q --target dev -t $(DEV_IMAGE) . >/dev/null

init: dev-image ## Create .env, generate signing keys and random demo passwords (idempotent)
	@docker run --rm -u $(HOST_UID):$(HOST_GID) -e HOME=/tmp -v "$(CURDIR)":/app -w /app $(DEV_IMAGE) python scripts/init.py

rotate-keys: dev-image ## Add a new active JWT signing key (previous key stays published)
	@docker run --rm -u $(HOST_UID):$(HOST_GID) -e HOME=/tmp -v "$(CURDIR)":/app -w /app $(DEV_IMAGE) python scripts/init.py --rotate-keys

.env:
	@$(MAKE) --no-print-directory init

up: .env ## Build and start db, migrate+seed, api, web (waits for health)
	$(COMPOSE) up -d --build --wait db api web

down: ## Stop the stack (keeps data)
	$(COMPOSE) --profile tools --profile e2e down --remove-orphans

logs: ## Follow logs
	$(COMPOSE) logs -f --tail=100

seed: .env ## Apply migrations and (re)seed sample data (idempotent)
	$(COMPOSE) up -d --wait db
	$(COMPOSE) run --rm --build migrate

demo: .env up seed ## Init if needed, start everything, seed, print URLs
	@echo ""
	@echo "Deal Desk is running (SAMPLE DATA ONLY, offline fake LLM)."
	@echo "  UI:           http://localhost:3000"
	@echo "  API docs:     http://localhost:8000/docs   (local only)"
	@echo "  Credentials:  DEMO_*_EMAIL / DEMO_*_PASSWORD in .env (generated by make init)"

gen-client: .env ## Regenerate the typed API client from the FastAPI OpenAPI schema
	$(DEV) python scripts/export_openapi.py web/openapi.json
	$(WEB_DEV) npm run gen:client

lint: .env ## ruff lint + format check
	$(DEV) sh -c "ruff check . && ruff format --check ."

typecheck: .env ## mypy --strict
	$(DEV) mypy

imports: .env ## Enforce hexagonal layer rules
	$(DEV) lint-imports

test: .env ## Unit + integration tests with coverage gates (85% overall, 100% branch on domain/)
	$(COMPOSE) up -d --wait db
	$(DEV_DB) sh -c "pytest --cov --cov-report=term-missing:skip-covered && coverage report --include='src/dealdesk/domain/*' --fail-under=100 >/dev/null && echo 'domain/ branch coverage: 100%'"

web-lint: .env ## ESLint + Prettier + TypeScript (strict) + stale-client check
	$(WEB_DEV) sh -c "npm run lint && npm run format:check && npm run typecheck"

web-test: .env ## Vitest + Testing Library
	$(WEB_DEV) npm run test

check: lint typecheck imports test web-lint web-test ## Everything except e2e and eval
	@echo "make check: all green"

eval: .env ## Offline evals against recorded FakeLLM fixtures
	$(DEV) python -m evals.run

eval-record: .env ## Re-record eval fixtures from the FakeLLM rules (after changing a prompt)
	$(DEV) python -m evals.run --record

eval-live: .env ## Evals against the configured real provider (sends sample briefs to it)
	$(DEV) python -m evals.run --live

e2e: .env ## Playwright + axe against the full Compose stack
	$(COMPOSE) up -d --build --wait db api web
	$(COMPOSE) run --rm --build migrate
	$(COMPOSE) --profile e2e run --rm --build playwright

tf-validate: ## terraform fmt -check + validate (never plan/apply)
	docker run --rm -v "$(CURDIR)/infra/terraform":/tf -w /tf -e TF_IN_AUTOMATION=1 --entrypoint sh $(TF_IMAGE) -c \
	  "terraform fmt -check -recursive && terraform init -backend=false -input=false >/dev/null && terraform validate"

helm-lint: ## helm lint + template
	docker run --rm -v "$(CURDIR)/deploy/helm":/charts -w /charts $(HELM_IMAGE) lint dealdesk --strict
	docker run --rm -v "$(CURDIR)/deploy/helm":/charts -w /charts $(HELM_IMAGE) template dealdesk dealdesk >/dev/null && echo "helm template: ok"

audit: .env ## Dependency audit (pip-audit + npm audit)
	$(DEV) sh -c "uv export --frozen --no-hashes --no-emit-project > /tmp/req.txt && pip-audit -r /tmp/req.txt --no-deps --disable-pip"
	$(WEB_DEV) npm audit --omit=dev --audit-level=high

secrets-scan: ## gitleaks over the git history
	docker run --rm -v "$(CURDIR)":/repo $(GITLEAKS_IMAGE) git /repo --redact --no-banner

clean: ## Stop everything and delete volumes and local build output (keeps .env and keys)
	$(COMPOSE) --profile tools --profile e2e down -v --remove-orphans
	rm -rf .mypy_cache .ruff_cache .pytest_cache .hypothesis .coverage htmlcov web/.next web/test-results web/playwright-report
